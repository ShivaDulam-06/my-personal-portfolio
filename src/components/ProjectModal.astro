---
// Reusable project-detail modal. Renders a single <dialog> shell
// plus an inline script that opens it from any element carrying
// data-open-project="<anchor>". The project data is emitted as a
// JSON blob at build time, so both the homepage and the Projects
// page share one modal with no UI framework or extra dependencies.
//
// Accessibility: native <dialog> semantics, Escape to close, visible
// close button, backdrop-click close (without closing on content
// click), focus management, focus return to the trigger, background
// scroll lock, and prefers-reduced-motion support.

import { projects } from '../data/projects';
import ArchitectureDiagram from './ArchitectureDiagram.astro';

const detailProjects = projects.filter((p) => p.hasDetails);
const projectData = detailProjects.map((p) => ({
  id: p.anchor,
  title: p.title,
  status: p.status,
  link: p.link,
  overview: p.overview,
  tech: p.tech,
  simulationNote: p.simulationNote,
}));
---

<dialog id="project-modal" class="project-modal" aria-labelledby="project-modal-title">
  <div class="project-modal-backdrop" data-modal-close></div>
  <div class="project-modal-panel" role="document">
    <button
      type="button"
      class="project-modal-close"
      data-modal-close-button
      aria-label="Close project details"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
        <path d="M4 4 L14 14 M14 4 L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>

    <div class="project-modal-body" id="project-modal-body">
      {detailProjects.map((project) => (
        <div class="project-modal-content" data-project-content={project.anchor} hidden={project.anchor !== detailProjects[0]?.anchor}>
          <div class="modal-visual">
            <ArchitectureDiagram variant="expanded" />
          </div>

          <div class="modal-meta">
            <div class="modal-status">
              <span class="badge-status badge-status--completed">{project.status}</span>
              <span class="badge-status badge-status--sim">Wokwi Simulation</span>
            </div>
            <h2 id="project-modal-title" class="modal-title">{project.title}</h2>
          </div>

          {project.overview && (
            <p class="modal-overview">{project.overview}</p>
          )}

          {project.tech && project.tech.length > 0 && (
            <div class="modal-tech">
              {project.tech.map((t) => (
                <span class="badge">{t}</span>
              ))}
            </div>
          )}

          {project.simulationNote && project.simulationNote.length > 0 && (
            <p class="modal-disclaimer">
              {project.simulationNote[0]}
            </p>
          )}

          {project.link && (
            <div class="modal-actions">
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="modal-github-btn"
              >
                <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0016 8c0-4.42-3.58-8-8-8z" />
                </svg>
                View Repository on GitHub
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ projectData }}>
  (function () {
    var modal = document.getElementById('project-modal');
    if (!modal) return;
    var backdrop = modal.querySelector('.project-modal-backdrop');
    var contents = modal.querySelectorAll('[data-project-content]');
    var lastFocused = null;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function showContent(id) {
      contents.forEach(function (node) {
        var match = node.getAttribute('data-project-content') === id;
        node.hidden = !match;
        if (match) {
          node.id = 'project-modal-active';
        } else if (node.id === 'project-modal-active') {
          node.removeAttribute('id');
        }
      });
    }

    function openModal(trigger, id) {
      lastFocused = trigger;
      showContent(id);
      modal.showModal();
      document.body.style.overflow = 'hidden';
      var closeBtn = modal.querySelector('[data-modal-close-button]');
      if (closeBtn) {
        requestAnimationFrame(function () {
          closeBtn.focus();
        });
      }
    }

    function closeModal() {
      if (!modal.open) return;
      modal.classList.add('project-modal--closing');
      var done = function () {
        modal.removeEventListener('animationend', done);
        modal.classList.remove('project-modal--closing');
        modal.close();
        document.body.style.overflow = '';
        if (lastFocused && typeof lastFocused.focus === 'function') {
          lastFocused.focus();
          lastFocused = null;
        }
      };
      if (reduceMotion) {
        done();
      } else {
        modal.addEventListener('animationend', done);
        setTimeout(done, 400);
      }
    }

    // Open triggers — any element carrying data-open-project.
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-open-project]');
      if (trigger) {
        e.preventDefault();
        var id = trigger.getAttribute('data-open-project');
        openModal(trigger, id);
      }
    });

    // Open via keyboard (Enter / Space) on non-button triggers.
    document.addEventListener('keydown', function (e) {
      if (e.target && e.target.matches && e.target.matches('[data-open-project]')) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          var id = e.target.getAttribute('data-open-project');
          openModal(e.target, id);
        }
      }
    });

    // Close: X button uses a distinct selector so it can never be
    // confused with the backdrop. The backdrop closes only when the
    // click lands directly on it. Both call the same closeModal().
    modal.addEventListener('click', function (e) {
      if (e.target instanceof Element && e.target.closest('[data-modal-close-button]')) {
        closeModal();
        return;
      }
      if (e.target === backdrop) {
        closeModal();
      }
    });

    // Escape is handled natively by <dialog>; restore state.
    modal.addEventListener('close', function () {
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
        lastFocused = null;
      }
    });

    // Keep focus inside the dialog while open.
    modal.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;
      var focusable = modal.querySelectorAll(
        'button, a[href], [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>

<style>
  .project-modal {
    border: none;
    background: transparent;
    padding: 0;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    color: var(--text-primary);
    overflow: hidden;
  }

  .project-modal::backdrop {
    background: rgba(8, 11, 16, 0.72);
    backdrop-filter: blur(2px);
  }

  .project-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .project-modal-panel {
    position: relative;
    z-index: 1;
    margin: 6vh auto;
    width: min(640px, 92vw);
    max-height: 88vh;
    background: var(--navy-850);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .project-modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .project-modal-close:hover {
    color: var(--text-primary);
    border-color: var(--accent-border);
    background: rgba(126, 160, 204, 0.08);
  }

  .project-modal-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .project-modal-body {
    overflow-y: auto;
    padding: 28px;
    -webkit-overflow-scrolling: touch;
  }

  .project-modal-content {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* --- Architecture visual: moderate, balanced size --- */
  .modal-visual {
    background: rgba(13, 17, 23, 0.5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  /* Constrain the expanded diagram to a moderate height so it is
     clearly visible without dominating the modal. Width scales
     naturally while the SVG preserves its aspect ratio. */
  .modal-visual :global(.arch-diagram--expanded) {
    width: 100%;
    align-items: center;
  }

  .modal-visual :global(.arch-diagram--expanded .arch-svg) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 190px;
    margin: 0 auto;
  }

  /* Center and size the legend compactly beneath the diagram. */
  .modal-visual :global(.arch-diagram--expanded .arch-legend) {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
  }

  .modal-meta {
    padding-right: 40px;
  }

  .modal-status {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .modal-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .modal-overview {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .modal-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .modal-disclaimer {
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.6;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* --- GitHub button --- */
  .modal-actions {
    margin-top: 4px;
  }

  .modal-github-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    padding: 13px 20px;
    font-size: 14px;
    font-weight: 500;
    font-family: var(--font-sans);
    color: var(--text-primary);
    background: var(--navy-900, #0d1117);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.25s ease, background 0.2s ease;
  }

  .modal-github-btn:hover {
    background: rgba(126, 160, 204, 0.1);
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-border), 0 4px 18px rgba(126, 160, 204, 0.18);
  }

  .modal-github-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .modal-github-btn:active {
    transform: translateY(1px);
  }

  /* --- Entrance / exit animations --- */
  @media (prefers-reduced-motion: no-preference) {
    .project-modal[open] .project-modal-panel {
      animation: modal-fade-scale 0.24s ease-out;
    }

    .project-modal--closing .project-modal-panel {
      animation: modal-fade-scale-out 0.22s ease-in forwards;
    }

    @keyframes modal-fade-scale {
      from {
        opacity: 0;
        transform: scale(0.97) translateY(8px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    @keyframes modal-fade-scale-out {
      from {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
      to {
        opacity: 0;
        transform: scale(0.97) translateY(8px);
      }
    }
  }

  /* --- Mobile: nearly full-screen slide-up panel --- */
  @media (max-width: 768px) {
    .project-modal-panel {
      margin: 0;
      width: 100%;
      max-width: 100%;
      max-height: 100vh;
      max-height: 100dvh;
      height: 100vh;
      height: 100dvh;
      border-radius: 0;
      border-left: none;
      border-right: none;
      border-bottom: none;
    }

    .project-modal-body {
      padding: 20px;
      padding-top: 56px;
      padding-top: calc(56px + env(safe-area-inset-top));
      padding-bottom: calc(20px + env(safe-area-inset-bottom));
    }

    .project-modal-close {
      top: 16px;
      top: calc(16px + env(safe-area-inset-top));
      right: 16px;
      right: calc(16px + env(safe-area-inset-right));
    }

    .modal-visual {
      padding: 12px;
    }

    .modal-visual :global(.arch-diagram--expanded .arch-svg) {
      max-height: 145px;
    }

    .modal-visual :global(.arch-diagram--expanded .arch-legend) {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) and (prefers-reduced-motion: no-preference) {
    .project-modal[open] .project-modal-panel {
      animation: modal-slide-up 0.26s ease-out;
    }

    .project-modal--closing .project-modal-panel {
      animation: modal-slide-down 0.22s ease-in forwards;
    }

    @keyframes modal-slide-up {
      from {
        opacity: 0.5;
        transform: translateY(100%);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes modal-slide-down {
      from {
        opacity: 1;
        transform: translateY(0);
      }
      to {
        opacity: 0;
        transform: translateY(100%);
      }
    }
  }
</style>
