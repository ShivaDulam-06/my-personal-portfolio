---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="Resume — Shiva Dulam"
  description="Resume of Shiva Dulam, an electronics and embedded systems engineer — profile, education, internship experience, and technical skills across microcontroller programming, firmware, and circuit design. Downloadable PDF available."
>
  <div class="page-header">
    <h1>Resume</h1>
    <p class="subtitle">A summary of my background, education, and experience.</p>
  </div>

  <section class="section">
    <a href={site.resumePath} download class="btn btn-primary resume-download">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      Download Resume (PDF)
    </a>
  </section>

  <section class="section">
    <h2>Profile</h2>
    <p>
      Electronics and embedded systems engineer with a growing foundation in microcontroller
      programming, circuit design, and firmware development. Currently building practical projects
      to strengthen hands-on experience across the embedded stack.
    </p>
  </section>

  <section class="section">
    <h2>Education</h2>
    <div class="resume-item">
      <div class="resume-item-header">
        <span class="resume-item-title">B_TECH | ECM</span>
        <span class="resume-item-date">2025 - 2029</span>
      </div>
      <p class="resume-item-sub">JBIET</p>
      <p>Relevant coursework: digital electronics, microcontrollers, signals and systems, embedded programming.</p>
    </div>
  </section>

  <section class="section">
    <h2>Experience</h2>
    <div class="resume-item">
      <div class="resume-item-header">
        <span class="resume-item-title">Embedded &amp; IoT Intern</span>
        <span class="resume-item-date">September 2026 (1 month)</span>
      </div>
      <p class="resume-item-sub">Upskill Campus × UniConverge Technologies Pvt. Ltd.</p>
      <p>
        Worked on a Smart Agriculture Monitoring System, applying embedded systems and IoT concepts
        to a real-world agricultural use case as part of a structured virtual internship program.
      </p>
    </div>
    <div class="resume-item">
      <div class="resume-item-header">
        <span class="resume-item-title">Personal / Academic Projects</span>
        <span class="resume-item-date">2025 — Present</span>
      </div>
      <p>
        Developing embedded systems projects with STM32 and ESP32 microcontrollers, covering
        peripheral interfacing, sensor integration, and real-time firmware.
      </p>
    </div>
  </section>

  <section class="section">
    <h2>Technical Skills</h2>
    <p>
      See the <a href="/skills" class="inline-link">Skills page</a> for a categorized overview of
      hardware, microcontroller, firmware, and software tools I work with.
    </p>
  </section>
</Layout>

<style>
  .resume-download {
    margin-bottom: 14px;
    gap: 8px;
  }

  .resume-note {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .resume-note code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    background: var(--accent-muted);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .resume-item {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .resume-item:last-child {
    border-bottom: none;
  }

  .resume-item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .resume-item-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .resume-item-date {
    font-size: 13px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .resume-item-sub {
    font-size: 14px;
    color: var(--accent);
    margin-top: 4px;
    margin-bottom: 8px;
  }

  .inline-link {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .inline-link:hover {
    color: var(--accent-hover);
  }
</style>
