---
import Layout from '../layouts/Layout.astro';
import { skillCategories } from '../data/skills';
---

<Layout
  title="Skills — Shiva Dulam"
  description="Skills and tools Shiva Dulam is working with across the embedded stack — microcontrollers, firmware languages, electronics design tools, IoT, and edge AI technologies, grouped by area."
>
  <div class="page-header">
    <h1>Skills</h1>
    <p class="subtitle">
      Technologies and tools I'm working with, grouped by area. This list grows as I learn.
    </p>
  </div>

  <div class="skills-list">
    {skillCategories.map((category) => (
      <section class="skill-category">
        <h2>{category.title}</h2>
        <div class="skill-badges">
          {category.skills.map((skill) => (
            <span class="badge">{skill}</span>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .skill-category h2 {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 14px;
    letter-spacing: -0.01em;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .skill-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill-badges .badge {
    transition: border-color 0.2s ease, box-shadow 0.25s ease, color 0.2s ease;
  }

  .skill-badges .badge:hover {
    border-color: var(--accent-border);
    box-shadow: 0 0 0 1px var(--accent-border), 0 2px 12px rgba(126, 160, 204, 0.08);
    color: var(--accent-hover);
  }
</style>
