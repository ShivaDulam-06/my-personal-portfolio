---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import ProjectModal from '../components/ProjectModal.astro';

const homeTitle ='Shiva Dulam — Electronics, Embedded Systems & PCB Engineer';
const homeDescription =
  'Portfolio of Shiva Dulam, an embedded systems and PCB engineer building microcontroller firmware, IoT, edge AI, and PCB designs with STM32 and ESP32.';

const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Shiva Dulam',
  alternateName: ['Shiva Dulam Portfolio', 'Shiva Dulam'],
  url: 'https://shivadulam.is-a.dev/',
});

const featured = projects.find((p) => p.featured);
const featuredTech = featured ? featured.tech.slice(0, 4) : [];
---

<Layout
  title={homeTitle}
  description={homeDescription}
  googleSiteVerification="2sdbvBRyX-yYWH2eCiqGZWJvKgCUbXmEyKeeWWmoYmU"
  jsonLd={websiteJsonLd}
>
  <section class="hero">
    <p class="hero-eyebrow">Portfolio</p>
    <h1>{site.name}</h1>
    <p class="hero-title">{site.title}</p>
    <span class="status-pill">Open to internships &amp; opportunities</span>
    <div class="hero-domains">
      <span class="domain-tag">Embedded Systems</span>
      <span class="domain-tag">IoT &amp; Edge AI</span>
      <span class="domain-tag">PCB Design</span>
    </div>
    <p class="hero-intro">
      I'm currently building my skills and working on hands-on projects across three core domains —
      embedded firmware, IoT connectivity, and PCB design — with a growing focus on edge AI and
      TinyML for resource-constrained devices. My focus is on understanding systems from the circuit
      board up through the code that runs on it.
    </p>
    <div class="hero-actions">
      <a href="/projects" class="btn btn-primary">View Projects</a>
      <a href="/contact" class="btn btn-outline">Contact</a>
    </div>
  </section>

  {featured && (
    <section class="featured-work">
      <div class="featured-heading">
        <p class="featured-eyebrow">Featured Engineering Work</p>
      </div>

      <div class="featured-card-shell">
        <button
          type="button"
          class="featured-card"
          data-open-project={featured.anchor}
          aria-label={`View details for ${featured.title}`}
        >
          <div class="featured-card-visual">
            <ArchitectureDiagram variant="compact" />
          </div>

          <div class="featured-card-body">
            <div class="featured-status">
              <span class="badge-status badge-status--completed">Completed</span>
              <span class="badge-status badge-status--sim">Wokwi Simulation</span>
            </div>

            <h2 class="featured-card-title">{featured.title}</h2>

            <p class="featured-card-desc">{featured.description}</p>

            <div class="featured-tech">
              {featuredTech.map((t) => (
                <span class="badge">{t}</span>
              ))}
            </div>

            <span class="view-details">
              View Details <span class="arrow">&rarr;</span>
            </span>
          </div>
        </button>

        {featured.link && (
          <a
            href={featured.link}
            target="_blank"
            rel="noopener noreferrer"
            class="featured-github-link"
          >
            GitHub Repository <span class="arrow">&rarr;</span>
          </a>
        )}
      </div>

      <a href="/projects" class="view-all-link">
        View All Projects <span class="arrow">&rarr;</span>
      </a>
    </section>
  )}

  <section class="hero-cards">
    <div class="hero-card">
      <h3>Currently Learning</h3>
      <p>Embedded systems, firmware development, and PCB design for microcontroller-based projects.</p>
    </div>
    <div class="hero-card">
      <h3>Building Projects</h3>
      <p>Hands-on work with STM32, ESP32, PCB designs and RTOS — see the Projects page.</p>
    </div>
    <div class="hero-card">
      <h3>Long-Term Goal</h3>
      <p>To design reliable embedded systems that bridge hardware and software for real-world applications.</p>
    </div>
  </section>

  <ProjectModal />
</Layout>

<style>
  .hero {
    padding: 32px 0 48px;
    max-width: 640px;
  }

  .hero-eyebrow {
    font-size: 13px;
    font-family: var(--font-mono);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }

  .hero h1 {
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.15;
  }

  .hero-title {
    font-size: 18px;
    font-weight: 400;
    color: var(--text-secondary);
    margin-top: 8px;
  }

  .status-pill {
    display: inline-block;
    margin-top: 20px;
    padding: 5px 14px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-muted);
    border: 1px solid var(--accent-border);
    border-radius: 100px;
    letter-spacing: 0.01em;
  }

  .hero-domains {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .domain-tag {
    display: inline-block;
    padding: 5px 12px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 100px;
    transition: border-color 0.2s ease, box-shadow 0.25s ease, color 0.2s ease;
  }

  .domain-tag:hover {
    border-color: var(--accent-border);
    box-shadow: 0 0 0 1px var(--accent-border), 0 2px 12px rgba(126, 160, 204, 0.08);
    color: var(--accent-hover);
  }

  .hero-intro {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-top: 28px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  /* --- Featured Engineering Work --- */
  .featured-work {
    margin-top: 56px;
  }

  .featured-heading {
    margin-bottom: 20px;
  }

  .featured-eyebrow {
    font-size: 13px;
    font-family: var(--font-mono);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .featured-card-shell {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    transition: border-color 0.2s ease, box-shadow 0.25s ease;
  }

  .featured-card-shell:hover {
    border-color: var(--accent-border);
    box-shadow: 0 0 0 1px var(--accent-border), 0 4px 24px rgba(126, 160, 204, 0.08);
  }

  .featured-card {
    display: grid;
    grid-template-columns: minmax(0, 200px) minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: inherit;
    font: inherit;
  }

  .featured-card-visual {
    background: rgba(13, 17, 23, 0.5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px;
    overflow: hidden;
    transition: transform 0.25s ease;
  }

  .featured-card:hover .featured-card-visual {
    transform: scale(1.03);
  }

  .featured-card-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .featured-status {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .badge-status--sim {
    background: rgba(126, 160, 204, 0.12);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .featured-card-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .featured-card-desc {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .featured-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .view-details {
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 0.2s ease;
  }

  .featured-card:hover .view-details {
    color: var(--accent-hover);
  }

  .featured-card .arrow,
  .featured-github-link .arrow,
  .view-all-link .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .featured-card:hover .view-details .arrow {
    transform: translateX(3px);
  }

  .featured-github-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .featured-github-link:hover {
    color: var(--accent-hover);
  }

  .featured-github-link:hover .arrow {
    transform: translateX(3px);
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .view-all-link:hover {
    color: var(--accent);
  }

  .view-all-link:hover .arrow {
    transform: translateX(3px);
  }

  .hero-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 56px;
  }

  .hero-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    transition: border-color 0.2s ease;
  }

  .hero-card:hover {
    border-color: var(--border-hover);
  }

  .hero-card h3 {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .hero-card p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 16px 0 36px;
    }

    .hero h1 {
      font-size: 30px;
    }

    .hero-title {
      font-size: 16px;
    }

    .hero-actions {
      flex-direction: column;
    }

    .featured-card {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .hero-cards {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
