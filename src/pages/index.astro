---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';

const homeTitle ='Shiva Dulam — Electronics, Embedded Systems & PCB Engineer';
const homeDescription =
  'Portfolio of Shiva Dulam, an embedded systems and PCB engineer building microcontroller firmware, IoT, edge AI, and PCB designs with STM32 and ESP32.';

const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Shiva Dulam',
  alternateName: ['Shiva Dulam Portfolio', 'Shiva Dulam'],
  url: 'https://shivadulam.is-a.dev/',
});

const featured = projects.find((p) => p.featured);
---

<Layout
  title={homeTitle}
  description={homeDescription}
  googleSiteVerification="2sdbvBRyX-yYWH2eCiqGZWJvKgCUbXmEyKeeWWmoYmU"
  jsonLd={websiteJsonLd}
>
  <section class="hero">
    <p class="hero-eyebrow">Portfolio</p>
    <h1>{site.name}</h1>
    <p class="hero-title">{site.title}</p>
    <span class="status-pill">Open to internships &amp; opportunities</span>
    <div class="hero-domains">
      <span class="domain-tag">Embedded Systems</span>
      <span class="domain-tag">IoT &amp; Edge AI</span>
      <span class="domain-tag">PCB Design</span>
    </div>
    <p class="hero-intro">
      I'm currently building my skills and working on hands-on projects across three core domains —
      embedded firmware, IoT connectivity, and PCB design — with a growing focus on edge AI and
      TinyML for resource-constrained devices. My focus is on understanding systems from the circuit
      board up through the code that runs on it.
    </p>
    <div class="hero-actions">
      <a href="/projects" class="btn btn-primary">View Projects</a>
      <a href="/contact" class="btn btn-outline">Contact</a>
    </div>
  </section>

  {featured && (
    <section class="featured-work">
      <div class="featured-heading">
        <p class="featured-eyebrow">Featured Engineering Work</p>
        <h2>{featured.title}</h2>
      </div>

      <article class="featured-card">
        <div class="featured-status">
          <span class="badge-status badge-status--completed">Completed</span>
          <span class="badge-status badge-status--sim">Wokwi Simulation</span>
        </div>

        <p class="featured-desc">{featured.description}</p>

        <div class="featured-tech">
          {featured.tech.map((t) => (
            <span class="badge">{t}</span>
          ))}
        </div>

        <p class="featured-note">
          Monitors soil moisture, ambient light, temperature, and humidity on an ESP32, timestamps
          each reading via RTC, shows live status on an I2C LCD, and automatically switches a
          relay-driven water pump when soil crosses a dryness threshold — all running on local,
          on-device logic.
        </p>

        <p class="featured-disclosure">
          Simulated in Wokwi. The FC-28 soil sensor is represented by a potentiometer; this version
          does not implement Wi-Fi/MQTT and is not physically validated hardware.
        </p>

        <div class="featured-actions">
          <a href={`/projects#${featured.anchor}`} class="btn btn-primary">View Project</a>
          <a
            href={featured.link}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            GitHub Repository
          </a>
        </div>
      </article>
    </section>
  )}

  <section class="hero-cards">
    <div class="hero-card">
      <h3>Currently Learning</h3>
      <p>Embedded systems, firmware development, and PCB design for microcontroller-based projects.</p>
    </div>
    <div class="hero-card">
      <h3>Building Projects</h3>
      <p>Hands-on work with STM32, ESP32, and real-time operating systems — see the Projects page.</p>
    </div>
    <div class="hero-card">
      <h3>Long-Term Goal</h3>
      <p>To design reliable embedded systems that bridge hardware and software for real-world applications.</p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 32px 0 48px;
    max-width: 640px;
  }

  .hero-eyebrow {
    font-size: 13px;
    font-family: var(--font-mono);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }

  .hero h1 {
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.15;
  }

  .hero-title {
    font-size: 18px;
    font-weight: 400;
    color: var(--text-secondary);
    margin-top: 8px;
  }

  .status-pill {
    display: inline-block;
    margin-top: 20px;
    padding: 5px 14px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-muted);
    border: 1px solid var(--accent-border);
    border-radius: 100px;
    letter-spacing: 0.01em;
  }

  .hero-domains {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .domain-tag {
    display: inline-block;
    padding: 5px 12px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 100px;
    transition: border-color 0.2s ease, box-shadow 0.25s ease, color 0.2s ease;
  }

  .domain-tag:hover {
    border-color: var(--accent-border);
    box-shadow: 0 0 0 1px var(--accent-border), 0 2px 12px rgba(126, 160, 204, 0.08);
    color: var(--accent-hover);
  }

  .hero-intro {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-top: 28px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  /* --- Featured Engineering Work --- */
  .featured-work {
    margin-top: 56px;
  }

  .featured-heading {
    margin-bottom: 20px;
  }

  .featured-eyebrow {
    font-size: 13px;
    font-family: var(--font-mono);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }

  .featured-heading h2 {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .featured-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    transition: border-color 0.2s ease, box-shadow 0.25s ease;
  }

  .featured-card:hover {
    border-color: var(--accent-border);
    box-shadow: 0 0 0 1px var(--accent-border), 0 4px 24px rgba(126, 160, 204, 0.08);
  }

  .featured-status {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .badge-status--sim {
    background: rgba(126, 160, 204, 0.12);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .featured-desc {
    font-size: 15px;
    color: var(--text-primary);
    line-height: 1.7;
    margin-bottom: 18px;
  }

  .featured-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .featured-note {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 14px;
  }

  .featured-disclosure {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 20px;
  }

  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 8px;
  }

  .hero-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    transition: border-color 0.2s ease;
  }

  .hero-card:hover {
    border-color: var(--border-hover);
  }

  .hero-card h3 {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .hero-card p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 16px 0 36px;
    }

    .hero h1 {
      font-size: 30px;
    }

    .hero-title {
      font-size: 16px;
    }

    .hero-actions {
      flex-direction: column;
    }

    .featured-actions {
      flex-direction: column;
    }

    .hero-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
